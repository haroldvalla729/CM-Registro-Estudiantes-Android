<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo_app"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- ENCABEZADO PRINCIPAL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_registro"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/azul_primario"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitulo_registro"
            android:textSize="14sp"
            android:textColor="@color/gris_texto"
            android:layout_marginBottom="28dp" />

        <!-- SECCIÓN 1: DATOS PERSONALES -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_nombre"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/negro_texto"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nombre"
            android:inputType="textPersonName|textCapWords"
            android:autofillHints="name"
            android:minHeight="48dp"
            android:padding="14dp"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <!-- SECCIÓN 2: SELECCIÓN DE CARRERA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_carrera"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/negro_texto"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgCarrera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/rbTI"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rb_ti"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minHeight="48dp" />

            <RadioButton
                android:id="@+id/rbAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rb_admin"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minHeight="48dp" />

            <RadioButton
                android:id="@+id/rbContabilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rb_conta"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minHeight="48dp" />
        </RadioGroup>

        <!-- SECCIÓN 3: MODALIDAD -->
        <CheckBox
            android:id="@+id/cbVirtual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cb_virtual"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/gris_oscuro"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minHeight="48dp"
            android:layout_marginBottom="32dp" />

        <!-- BOTÓN PRINCIPAL -->
        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_registrar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/blanco"
            android:backgroundTint="@color/azul_primario"
            android:minHeight="54dp" />

    </LinearLayout>
</ScrollView>